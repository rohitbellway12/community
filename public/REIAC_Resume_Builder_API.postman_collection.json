                            "mode": "raw",
                            "raw": "{\n    \"id\": null,\n    \"title\": \"My Korean Standard Resume\",\n    \"template\": \"korean_standard\",\n    \"language\": \"ko\",\n    \"personal_info\": {\n        \"full_name\": \"김민수 (MIN SOO KIM)\",\n        \"english_name\": \"MIN SOO KIM\",\n        \"date_of_birth\": \"1996.08.20\",\n        \"gender\": \"남 (Male)\",\n        \"job_title\": \"백엔드 소프트웨어 엔지니어\",\n        \"total_experience\": \"3년 6개월\",\n        \"email\": \"minsoo.kim@example.kr\",\n        \"phone\": \"010-9876-5432\",\n        \"emergency_phone\": \"010-1234-5678\",\n        \"location\": \"서울특별시 강남구 테헤란로 123\",\n        \"linkedin\": \"https://linkedin.com/in/minsoo-kim\",\n        \"github\": \"https://github.com/minsoo-kim\",\n        \"portfolio\": \"https://minsoo.dev\",\n        \"photo_url\": \"\",\n        \"declaration_date\": \"2026년 10월 27일\",\n        \"signature_name\": \"김민수\"\n    },\n    \"education\": [\n        {\n            \"institution\": \"서울대학교\",\n            \"field\": \"컴퓨터공학부\",\n            \"degree\": \"학사\",\n            \"grade\": \"3.9 / 4.5\",\n            \"start_date\": \"2016.03\",\n            \"end_date\": \"2021.02\",\n            \"is_current\": false\n        }\n    ],\n    \"experience\": [\n        {\n            \"title\": \"주임 연구원 (Senior Backend Engineer)\",\n            \"company\": \"네이버 (Naver Corp)\",\n            \"location\": \"플랫폼 개발실 (Seoul, Korea)\",\n            \"start_date\": \"2022.03\",\n            \"end_date\": \"2024.01\",\n            \"is_current\": false,\n            \"rawNotes\": \"대규모 분산 트래픽을 처리하는 이벤트 기반 마이크로서비스 설계 및 구축\",\n            \"points\": [\n                \"Architected event-driven microservices processing 2.5M daily transactions on AWS ECS.\",\n                \"Coordinated cross-functional API standardization reducing response latency by 35%.\"\n            ]\n        }\n    ],\n    \"language_tests\": [\n        {\n            \"test_name\": \"TOEIC\",\n            \"score\": \"940\",\n            \"acquisition_date\": \"2023.09.15\",\n            \"organization\": \"ETS\"\n        },\n        {\n            \"test_name\": \"TOPIK\",\n            \"score\": \"Level 6 (최고등급)\",\n            \"acquisition_date\": \"2023.04.10\",\n            \"organization\": \"국립국제교육원\"\n        }\n    ],\n    \"certifications\": [\n        {\n            \"name\": \"정보처리기사 (Engineer Information Processing)\",\n            \"issuer\": \"한국산업인력공단\",\n            \"year\": \"2022.06\"\n        },\n        {\n            \"name\": \"AWS Certified Solutions Architect – Associate\",\n            \"issuer\": \"Amazon Web Services\",\n            \"year\": \"2023.05\"\n        }\n    ],\n    \"military_service\": {\n        \"status\": \"군필 (Completed)\",\n        \"branch\": \"육군 (ROK Army)\",\n        \"rank\": \"병장 (Sergeant)\",\n        \"period\": \"2018.06 ~ 2020.02\",\n        \"discharge_reason\": \"만기전역\"\n    },\n    \"computer_skills\": [\n        {\n            \"category\": \"프로그래밍\",\n            \"tool_name\": \"Python / Java / PHP\",\n            \"proficiency\": \"상 (Advanced)\",\n            \"description\": \"대규모 분산 데이터 처리 및 RESTful API 아키텍처 구현\"\n        },\n        {\n            \"category\": \"데이터베이스\",\n            \"tool_name\": \"MySQL / Redis / MongoDB\",\n            \"proficiency\": \"중상 (Upper-Intermediate)\",\n            \"description\": \"쿼리 최적화 및 캐싱 전략 수립\"\n        }\n    ],\n    \"skills\": [\n        \"PHP/Laravel\",\n        \"Python\",\n        \"AWS ECS\",\n        \"Docker\",\n        \"MySQL\",\n        \"Redis\",\n        \"RESTful API\",\n        \"Git\"\n    ],\n    \"self_introduction\": {\n        \"growth\": \"어릴 적부터 문제를 논리적으로 분석하고 시스템화하는 과정에 큰 흥미를 느꼈습니다. 대학에서 컴퓨터공학을 전공하며 기초 CS 지식을 탄탄히 다졌고, 작은 약속이라도 반드시 지키는 성실함을 제1의 가치관으로 삼고 있습니다.\",\n        \"personality\": \"저의 가장 큰 장점은 위기 상황에서도 흔들리지 않는 침착함과 팀원들과의 열린 소통입니다. 실수를 두려워하지 않고 빠른 회고와 수정을 통해 더 나은 솔루션을 도출해내는 유연성을 지니고 있습니다.\",\n        \"strengths\": \"네이버 플랫폼 개발실에서 2년간 실무를 수행하며 하루 250만 건 이상의 트래픽을 감당하는 고가용성 백엔드 서비스를 성공적으로 운영했습니다. 지속적인 리팩토링과 성능 최적화로 응답 시간을 35% 단축한 경험이 있습니다.\",\n        \"motivation_and_aspirations\": \"귀사가 추구하는 혁신적인 글로벌 비전에 깊이 공감하여 지원하게 되었습니다. 입사 후에는 축적된 백엔드 아키텍처 역량을 발휘하여 안정적인 대규모 인프라 확장에 기여하는 핵심 개발자로 성장하겠습니다.\"\n    },\n    \"projects\": [\n        {\n            \"title\": \"글로벌 전자상거래 실시간 결제 플랫폼\",\n            \"tech\": \"Laravel, Vue.js, Redis, Docker\",\n            \"description\": \"실시간 주문 및 결제 트랜잭션을 무중단 처리하는 분산 결제 게이트웨이 구축\",\n            \"url\": \"https://github.com/minsoo-kim/payment-gateway\"\n        }\n    ]\n}",
