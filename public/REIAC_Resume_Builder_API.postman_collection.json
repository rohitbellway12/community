{
    "info": {
        "name": "REIAC Resume Builder API Suite",
        "description": "Complete REST API collection for REIAC AI Resume Builder & Career Suite. Used by Flutter Mobile App & Web Frontend to manage all 7-step resume creation, AI bullet enhancements, template switching, photo uploads, and community watermark unlocking.",
