        "_postman_id": "reiac-resume-builder-v1-api"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost/community/api/v1",
            "type": "string",
            "description": "Base API endpoint URL"
        },
        {
            "key": "token",
            "value": "",
            "type": "string",
            "description": "Sanctum Bearer Token from /auth/login"
        },
        {
            "key": "resume_id",
            "value": "1",
            "type": "string",
            "description": "Current working Resume ID"
        }
    ],
    "item": [
        {
            "name": "0. Authentication (Token Setup)",
            "description": "Login endpoint to receive Bearer token. Running this automatically populates the {{token}} variable.",
            "item": [
                {
                    "name": "0.1 Login (Auto-saves {{token}})",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ],
                            "query": []
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@gmail.com\",\n    \"password\": \"password\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                                    "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                                    "    console.log(\"Bearer token automatically saved to collection variable!\");",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "0.2 Get Current User (Me)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "me"
                            ],
                            "query": []
                        }
                    }
                }
            ]
        },
