                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"question_id\": {{question_id}},\n    \"selected_option_id\": {{selected_option_id}}\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/tests/{{test_id}}/attempts/{{attempt_id}}/answer",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests",
                                "{{test_id}}",
                                "attempts",
                                "{{attempt_id}}",
                                "answer"
                            ]
                        },
                        "description": "Saves student's answer in real-time as they navigate questions (Auto-save)."
                    },
                    "response": []
                },
                {
                    "name": "Clear Selected Answer",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"question_id\": {{question_id}}\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/tests/{{test_id}}/attempts/{{attempt_id}}/clear-answer",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests",
                                "{{test_id}}",
                                "attempts",
                                "{{attempt_id}}",
                                "clear-answer"
                            ]
                        },
                        "description": "Clears response for a question if student wants to deselect an option."
                    },
                    "response": []
                },
                {
                    "name": "Toggle Mark for Review",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"question_id\": {{question_id}}\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/tests/{{test_id}}/attempts/{{attempt_id}}/mark-review",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests",
                                "{{test_id}}",
                                "attempts",
                                "{{attempt_id}}",
                                "mark-review"
                            ]
                        },
                        "description": "Toggles question flag for review on the question palette."
                    },
                    "response": []
                },
                {
                    "name": "Submit Examination",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"submission_type\": \"manual\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/tests/{{test_id}}/attempts/{{attempt_id}}/submit",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests",
                                "{{test_id}}",
                                "attempts",
                                "{{attempt_id}}",
                                "submit"
                            ]
                        },
                        "description": "Submits the exam, calculates final score, accuracy, pass/fail result, and generates certificate credentials."
                    },
                    "response": []
                }
            ],
            "description": "Live exam interaction endpoints during active testing."
        },
