{
    "info": {
        "name": "REIAC Online Tests API",
        "_postman_id": "e8f3b190-2784-45aa-b80c-7b2496a71e11",
        "description": "Complete and Dedicated Postman Collection for the Online Test Module (Mobile App & Web). Includes Test Discovery, Pre-test Camera Photo Verification, Interactive Exam Engine, Submission, Scorecard, and Certificate of Achievement APIs.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "🔑 1. Authentication (Helper)",
            "item": [
                {
                    "name": "Student Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.data && jsonData.data.token) {",
                                    "    pm.collectionVariables.set('token', jsonData.data.token);",
                                    "    console.log('Bearer Token updated successfully in collection variables!');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\",\n    \"device_name\": \"Mobile\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Authenticates the student and automatically updates the {{token}} collection variable for all subsequent requests."
                    },
                    "response": []
                }
            ],
            "description": "Helper endpoint to obtain Sanctum Bearer token for running test APIs."
        },
        {
            "name": "📋 2. Test Discovery & Instructions",
            "item": [
                {
                    "name": "List All Available Tests",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/tests",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests"
                            ]
                        },
                        "description": "Returns all published, non-expired tests. Filters targeted tests automatically so students only see tests for which they are eligible (all, group, or user). Response includes `require_camera_photo`, `target_type`, and `agency_name`."
                    },
                    "response": []
                },
                {
                    "name": "List Tests Filtered by Level",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/tests?test_level_id=1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests"
                            ],
                            "query": [
                                {
                                    "key": "test_level_id",
                                    "value": "1",
                                    "description": "ID of specific Test Level"
                                }
                            ]
                        },
                        "description": "Filters test catalog by specific proficiency level."
                    },
                    "response": []
                },
                {
                    "name": "Get Test Details & Instructions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/tests/{{test_id}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests",
                                "{{test_id}}"
                            ]
                        },
                        "description": "Fetches complete instructions, metrics (duration, total marks, passing cutoff), student attempt status, and flags: `require_camera_photo`, `agency_name`, `controller_name`, `director_name`."
                    },
                    "response": []
                }
            ],
            "description": "Endpoints to browse tests, check rules, and view admittance details."
        },
        {
            "name": "⚡ 3. Start Exam & Camera Photo Verification",
            "item": [
                {
                    "name": "Start Test (Option A: Image File Upload - Multipart)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.data && jsonData.data.attempt_id) {",
                                    "    pm.collectionVariables.set('attempt_id', jsonData.data.attempt_id);",
                                    "    console.log('Attempt ID set to: ' + jsonData.data.attempt_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "candidate_photo",
                                    "type": "file",
                                    "src": [],
                                    "description": "Clear candidate selfie or webcam photo file (JPEG/PNG)"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/tests/{{test_id}}/start",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests",
                                "{{test_id}}",
                                "start"
                            ]
                        },
                        "description": "Initiates test session by uploading candidate photo as multipart form-data. Stores image in public storage and links to attempt. Automatically updates {{attempt_id}}."
                    },
                    "response": []
                },
                {
                    "name": "Start Test (Option B: Base64 Webcam Snapshot - JSON)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.data && jsonData.data.attempt_id) {",
                                    "    pm.collectionVariables.set('attempt_id', jsonData.data.attempt_id);",
                                    "    console.log('Attempt ID set to: ' + jsonData.data.attempt_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"candidate_photo_base64\": \"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP...\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/tests/{{test_id}}/start",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests",
                                "{{test_id}}",
                                "start"
                            ]
                        },
                        "description": "Initiates test session by passing captured webcam snapshot as base64 Data URL. Ideal for Flutter camera preview / HTML5 canvas snapshots."
                    },
                    "response": []
                },
                {
                    "name": "Start Test (Option C: Standard - If Photo Not Required)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.data && jsonData.data.attempt_id) {",
                                    "    pm.collectionVariables.set('attempt_id', jsonData.data.attempt_id);",
                                    "    console.log('Attempt ID set to: ' + jsonData.data.attempt_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/tests/{{test_id}}/start",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "tests",
                                "{{test_id}}",
                                "start"
                            ]
                        },
                        "description": "Starts test when `require_camera_photo` is false, or resumes ongoing active session."
                    },
                    "response": []
                }
            ],
            "description": "APIs to begin test session with pre-test identity capture."
        },
